{%- liquid
  assign uid = 'dml-formula-' | append: section.id
  assign s = section.settings
-%}

<div id="{{ uid }}" class="dml-formula">
  <div class="dml-formula__wrap">
    <div class="dml-formula__head">
      {%- if s.eyebrow != blank -%}<p class="dml-formula__eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      <h2 class="dml-formula__title">{{ s.heading }}</h2>
      {%- if s.lead != blank -%}<p class="dml-formula__lead">{{ s.lead }}</p>{%- endif -%}
    </div>
    <ul class="dml-formula__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign card_alt = b.image.alt | default: b.title
          case b.fallback
            when 'dose'
              assign fallback = 'dml-formula-dose.jpg'
            when 'dual'
              assign fallback = 'dml-formula-dual.jpg'
            when 'pure'
              assign fallback = 'dml-formula-pure.jpg'
            when 'peptide'
              assign fallback = 'dml-collagen-science.jpg'
            else
              assign fallback = blank
          endcase
        -%}
        <li class="dml-formula__card" {{ block.shopify_attributes }}>
          {%- if b.image != blank -%}
            <div class="dml-formula__media">{{ b.image | image_url: width: 600 | image_tag: widths: '300, 450, 600', sizes: '(min-width: 861px) 25vw, 90vw', loading: 'lazy', decoding: 'async', alt: card_alt }}</div>
          {%- elsif fallback != blank -%}
            <div class="dml-formula__media"><img src="{{ fallback | asset_url }}" alt="{{ card_alt | escape }}" width="800" height="600" loading="lazy" decoding="async"></div>
          {%- endif -%}
          <h3 class="dml-formula__card-title">{{ b.title }}</h3>
          <p class="dml-formula__card-text">{{ b.text }}</p>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{%- style -%}
  #{{ uid }}, #{{ uid }} *, #{{ uid }} *::before, #{{ uid }} *::after { box-sizing: border-box; }
  #{{ uid }} :is(h2, h3, p, ul, li, div, img) { margin: 0; padding: 0; text-transform: none; letter-spacing: normal; }
  #{{ uid }} {
    --c-primary: {{ s.color_primary }};
    --c-accent: {{ s.color_accent }};
    --c-accent-text: {{ s.color_accent_text }};
    background: {{ s.color_bg }};
    padding: {{ s.padding_top }}px 20px {{ s.padding_bottom }}px;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 16px;
    line-height: 1.6;
    color: {{ s.color_text }};
  }
  #{{ uid }} .dml-formula__wrap { max-width: 1120px; margin: 0 auto; }
  #{{ uid }} .dml-formula__head { text-align: center; }
  #{{ uid }} .dml-formula__eyebrow { font: 700 12px/1.4 'Montserrat', sans-serif; letter-spacing: .14em; text-transform: uppercase; color: var(--c-accent-text); margin-bottom: 10px; }
  #{{ uid }} .dml-formula__title { font: 800 clamp(26px, 4vw, 38px)/1.15 'Montserrat', sans-serif; color: var(--c-primary); margin-bottom: 14px; }
  #{{ uid }} .dml-formula__lead { max-width: 620px; margin: 0 auto; }
  #{{ uid }} .dml-formula__grid { list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 22px; margin-top: 40px; }
  #{{ uid }} .dml-formula__card { background: {{ s.color_card }}; border: 1px solid {{ s.color_border }}; border-radius: 16px; padding: 18px 18px 24px; }
  #{{ uid }} .dml-formula__media { margin-bottom: 18px; border-radius: 12px; overflow: hidden; background: #f1f1f3; }
  #{{ uid }} .dml-formula__media img { display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; }
  #{{ uid }} .dml-formula__card-title { font: 700 18px/1.3 'Montserrat', sans-serif; color: var(--c-accent-text); margin-bottom: 8px; }
  #{{ uid }} .dml-formula__card-text { font-size: 15px; }

  @media (max-width: 860px) {
    #{{ uid }} { padding-top: {{ s.padding_top | times: 0.75 | round }}px; padding-bottom: {{ s.padding_bottom | times: 0.75 | round }}px; }
    #{{ uid }} .dml-formula__grid { grid-template-columns: 1fr; }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "DML Formula cards",
  "class": "dml-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The science" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why this formula works" },
    { "type": "textarea", "id": "lead", "label": "Intro" },
    { "type": "color", "id": "color_primary", "label": "Primary", "default": "#202f5a" },
    { "type": "color", "id": "color_accent", "label": "Accent", "default": "#e96046" },
    { "type": "color", "id": "color_accent_text", "label": "Accent for small text", "default": "#bf4a30", "info": "Darker shade of the accent used for small text so it stays readable (WCAG AA)." },
    { "type": "color", "id": "color_text", "label": "Body text", "default": "#5b5b66" },
    { "type": "color", "id": "color_bg", "label": "Section background", "default": "#f6f4ef" },
    { "type": "color", "id": "color_card", "label": "Card background", "default": "#ffffff" },
    { "type": "color", "id": "color_border", "label": "Card border", "default": "#e7e3da" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        {
          "type": "select", "id": "fallback", "label": "Bundled image (if none uploaded)",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "dose", "label": "Clinically effective dose" },
            { "value": "dual", "label": "Dual-action formula" },
            { "value": "pure", "label": "Clean, pure ingredients" },
            { "value": "peptide", "label": "Hydrolysed peptide delivery" }
          ],
          "default": "none"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Card title" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Describe this point." }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "DML Formula cards",
      "blocks": [
        { "type": "card", "settings": { "fallback": "dose", "title": "Clinically effective dose", "text": "Each sachet delivers 5,000mg of collagen, a concentrated daily dose to support joints, cartilage and connective tissue." } },
        { "type": "card", "settings": { "fallback": "dual", "title": "Dual-action formula", "text": "Collagen supports structural tissue while turmeric extract supports a healthy inflammatory response. Two actives working together." } },
        { "type": "card", "settings": { "fallback": "pure", "title": "Clean, pure ingredients", "text": "No chemical fillers, artificial additives or unnecessary ingredients. Just collagen peptides and turmeric." } },
        { "type": "card", "settings": { "fallback": "peptide", "title": "Hydrolysed peptide delivery", "text": "Collagen is broken down into small hydrolysed peptides, so it is easier to digest and is absorbed quickly into the bloodstream." } }
      ]
    }
  ]
}
{% endschema %}
