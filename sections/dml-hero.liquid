{%- liquid
  assign uid = 'dml-hero-' | append: section.id
  assign s = section.settings
  assign product = s.product
  assign variant = product.selected_or_first_available_variant
  assign price_text = s.price_text
  assign member_cents = 0
  assign member_note = ''
  assign per_day_text = ''
  if product != blank
    assign price_text = variant.price | money
    for alloc in variant.selling_plan_allocations
      if member_cents == 0 or alloc.per_delivery_price < member_cents
        assign member_cents = alloc.per_delivery_price
      endif
    endfor
    if member_cents > 0
      assign member_amount = member_cents | money
      assign member_note = s.member_note | replace: '{amount}', member_amount
      assign day_cents = member_cents | divided_by: 30 | round
      assign day_amount = day_cents | money
      assign per_day_text = s.per_day | replace: '{amount}', day_amount
    endif
  endif
-%}

<div id="{{ uid }}" class="dml-hero">
  <div class="dml-hero__wrap">
    <div class="dml-hero__copy">
      {%- if s.eyebrow != blank -%}<p class="dml-hero__eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      <h1 class="dml-hero__title">{{ s.heading }}</h1>
      <p class="dml-hero__rating">
        <span class="dml-hero__stars" style="--rating: {{ s.rating }}" role="img" aria-label="{{ s.rating }} out of 5 stars">★★★★★</span>
        <a href="#{{ s.reviews_anchor }}">{{ s.rating }} from {{ s.review_count }} reviews</a>
      </p>
      {%- if s.description != blank -%}<div class="dml-hero__lead">{{ s.description }}</div>{%- endif -%}
      {%- if s.chips != blank -%}
        <ul class="dml-hero__chips">
          {%- assign chips = s.chips | newline_to_br | split: '<br />' -%}
          {%- for chip in chips -%}{%- assign c = chip | strip_newlines | strip -%}{%- if c != blank -%}<li>{{ c }}</li>{%- endif -%}{%- endfor -%}
        </ul>
      {%- endif -%}
      <p class="dml-hero__price"><strong>{{ price_text }}</strong><span>{{ s.price_note }}{% if member_note != blank %} · {{ member_note }}{% endif %}</span></p>
      {%- if per_day_text != blank -%}<p class="dml-hero__perday">{{ per_day_text }}</p>{%- endif -%}
      <div class="dml-hero__actions">
        <a class="dml-hero__btn" href="{{ s.cta_link }}" data-dml-track="hero_cta">{{ s.cta_label }}</a>
        {%- if s.link_label != blank -%}<a class="dml-hero__link" href="{{ s.link_url }}">{{ s.link_label }} →</a>{%- endif -%}
      </div>
      {%- if s.cta_note != blank -%}<p class="dml-hero__note">{{ s.cta_note }}</p>{%- endif -%}
    </div>

    <div class="dml-hero__media">
      {%- if s.image != blank -%}
        {{ s.image | image_url: width: 900 | image_tag: widths: '450, 600, 900', sizes: '(min-width: 861px) 45vw, 90vw', loading: 'eager', fetchpriority: 'high', alt: s.image.alt | default: s.heading }}
      {%- else -%}
        <img src="{{ 'dml-collagen-box.png' | asset_url }}" alt="{{ s.heading | escape }}" width="900" height="900" loading="eager" fetchpriority="high">
      {%- endif -%}
      {%- if s.badge_title != blank -%}
        <p class="dml-hero__badge">{{ s.badge_title }}<small>{{ s.badge_text }}</small></p>
      {%- endif -%}
    </div>
  </div>
</div>

{%- style -%}
  #{{ uid }}, #{{ uid }} *, #{{ uid }} *::before, #{{ uid }} *::after { box-sizing: border-box; }
  #{{ uid }} :is(h1, p, div, a, small, strong, span) { margin: 0; padding: 0; letter-spacing: normal; text-transform: none; }
  #{{ uid }} {
    --c-primary: {{ s.color_primary }};
    --c-accent: {{ s.color_accent }};
    --c-gold: {{ s.color_gold }};
    --c-text: #5b5b66;
    --f-head: 'Montserrat', system-ui, -apple-system, 'Segoe UI', sans-serif;
    --f-body: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
    display: block;
    padding: {{ s.padding_top }}px 0 {{ s.padding_bottom }}px;
    background: linear-gradient(160deg, #fbf9f4 0%, #eef0f8 100%);
    font-family: var(--f-body);
    font-size: 16px;
    line-height: 1.6;
    color: var(--c-text);
    -webkit-font-smoothing: antialiased;
  }
  #{{ uid }} .dml-hero__wrap { max-width: 1120px; margin: 0 auto; padding: 0 20px; display: grid; grid-template-columns: 1.05fr 1fr; gap: 40px; align-items: center; }
  #{{ uid }} .dml-hero__eyebrow { font: 700 12px/1.4 var(--f-head); letter-spacing: .14em; text-transform: uppercase; color: var(--c-accent); }
  #{{ uid }} .dml-hero__title { font: 800 clamp(32px, 5.2vw, 54px)/1.08 var(--f-head); color: var(--c-primary); margin: 10px 0 18px; }
  #{{ uid }} .dml-hero__rating { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; font-size: 14px; margin-bottom: 18px; }
  #{{ uid }} .dml-hero__stars { --p: calc(var(--rating) / 5 * 100%); font-size: 18px; letter-spacing: 2px; line-height: 1; background: linear-gradient(90deg, #f5a623 var(--p), #d9d9d9 var(--p)); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; color: transparent; }
  #{{ uid }} .dml-hero__rating a { color: inherit; text-decoration: underline; text-underline-offset: 3px; }
  #{{ uid }} .dml-hero__chips { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 22px; padding: 0; }
  #{{ uid }} .dml-hero__chips li { margin: 0; padding: 6px 12px 6px 28px; position: relative; background: #fff; border: 1px solid #e3e0d6; border-radius: 999px; font: 600 12px/1.3 var(--f-head); color: var(--c-primary); }
  #{{ uid }} .dml-hero__chips li::before { content: "✓"; position: absolute; left: 11px; top: 50%; transform: translateY(-50%); color: var(--c-accent); font-size: 12px; }
  #{{ uid }} .dml-hero__perday { display: inline-block; margin-bottom: 20px; padding: 4px 10px; background: rgba(248, 98, 57, .1); color: var(--c-accent); border-radius: 6px; font: 700 13px/1.4 var(--f-head); }
  #{{ uid }} .dml-hero__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 24px; }
  #{{ uid }} .dml-hero__link { color: var(--c-primary); font: 600 14px/1.2 var(--f-head); text-decoration: none; border-bottom: 2px solid var(--c-gold); padding-bottom: 2px; }
  #{{ uid }} .dml-hero__lead { max-width: 560px; margin-bottom: 24px; }
  #{{ uid }} .dml-hero__lead p { margin: 0; }
  #{{ uid }} .dml-hero__price { display: flex; align-items: baseline; flex-wrap: wrap; gap: 12px; margin-bottom: 8px; }
  #{{ uid }} .dml-hero__price strong { font: 800 32px/1.2 var(--f-head); color: var(--c-primary); }
  #{{ uid }} .dml-hero__price span { font-size: 14px; }
  #{{ uid }} .dml-hero__btn { display: inline-block; background: var(--c-accent); color: #fff; font: 700 16px/1.2 var(--f-head); padding: 16px 32px; border-radius: 999px; text-decoration: none; box-shadow: 0 8px 20px rgba(248, 98, 57, .28); transition: transform .15s, box-shadow .15s; }
  #{{ uid }} .dml-hero__btn:hover { transform: translateY(-2px); box-shadow: 0 12px 24px rgba(248, 98, 57, .35); }
  #{{ uid }} .dml-hero__btn:focus-visible { outline: 3px solid var(--c-primary); outline-offset: 3px; }
  #{{ uid }} .dml-hero__note { font-size: 13px; margin-top: 12px; }
  #{{ uid }} .dml-hero__media { position: relative; }
  #{{ uid }} .dml-hero__media img { display: block; width: 100%; height: auto; border-radius: 24px; box-shadow: 0 30px 60px rgba(27, 37, 80, .18); }
  #{{ uid }} .dml-hero__badge { position: absolute; left: -12px; bottom: 24px; background: var(--c-primary); color: #fff; padding: 12px 18px; border-radius: 14px; font: 600 13px/1.4 var(--f-head); box-shadow: 0 10px 24px rgba(0, 0, 0, .2); }
  #{{ uid }} .dml-hero__badge small { display: block; color: var(--c-gold); font-weight: 500; font-size: 13px; }

  @media (max-width: 860px) {
    #{{ uid }} .dml-hero__wrap { grid-template-columns: 1fr; }
    #{{ uid }} .dml-hero__media { order: -1; max-width: 420px; margin: 0 auto; }
    #{{ uid }} .dml-hero__badge { left: 8px; }
    #{{ uid }} .dml-hero__actions { flex-direction: column; align-items: stretch; text-align: center; }
    #{{ uid }} .dml-hero__btn { display: block; text-align: center; }
    #{{ uid }} .dml-hero__link { align-self: center; }
    #{{ uid }} .dml-hero__chips { justify-content: flex-start; }
  }
{%- endstyle -%}

<script>
  (function () {
    var btn = document.querySelector('#{{ uid }} [data-dml-track]');
    if (btn) btn.addEventListener('click', function () {
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ event: 'dml_hero_cta_click' });
    });
  })();
</script>

{% schema %}
{
  "name": "DML Hero",
  "class": "dml-section",
  "settings": [
    {
      "type": "header",
      "content": "Product"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "Optional. Price is read from the product; otherwise the text below is used."
    },
    {
      "type": "text",
      "id": "price_text",
      "label": "Price text (when no product)",
      "info": "Only used if no product is selected. With a product, the price follows the store currency."
    },
    {
      "type": "text",
      "id": "price_note",
      "label": "Price note",
      "default": "30 sachets"
    },
    {
      "type": "text",
      "id": "member_note",
      "label": "Membership note",
      "default": "or from {amount}/box with a membership",
      "info": "{amount} = lowest subscription price per delivery, in the store currency. Hidden if the product has no subscription plan."
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Dr. Mark Leong · Pure Collagen"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Support your joints. Move freely again."
    },
    {
      "type": "range",
      "id": "rating",
      "label": "Rating",
      "min": 1,
      "max": 5,
      "step": 0.1,
      "default": 4.5
    },
    {
      "type": "text",
      "id": "review_count",
      "label": "Review count",
      "default": "3,834"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Hydrolysed grass-fed bovine collagen with turmeric extract. One sachet a day to support joint health, muscle recovery and everyday flexibility.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Falls back to the bundled product image."
    },
    {
      "type": "text",
      "id": "badge_title",
      "label": "Badge title",
      "default": "Made in Taiwan"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "Grass-fed · Backed by clinical studies"
    },
    {
      "type": "textarea",
      "id": "chips",
      "label": "Proof chips (one per line)",
      "default": "Halal certified\n3rd-party lab tested\nGlyphosate free"
    },
    {
      "type": "text",
      "id": "per_day",
      "label": "Cost-per-day callout",
      "default": "Just {amount}/day with a membership",
      "info": "{amount} = lowest subscription price divided by 30 days. Hidden if the product has no subscription plan."
    },
    {
      "type": "text",
      "id": "reviews_anchor",
      "label": "Reviews anchor ID",
      "default": "reviews"
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Choose your plan"
    },
    {
      "type": "text",
      "id": "cta_link",
      "label": "Button link",
      "default": "#pricing"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Secondary link label",
      "default": "See what's inside"
    },
    {
      "type": "text",
      "id": "link_url",
      "label": "Secondary link",
      "default": "#ingredients"
    },
    {
      "type": "text",
      "id": "cta_note",
      "label": "Note under button",
      "default": "Free delivery on memberships · Cancel or pause anytime"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "color_primary",
      "label": "Primary",
      "default": "#1b2550"
    },
    {
      "type": "color",
      "id": "color_accent",
      "label": "Button / accent",
      "default": "#f86239"
    },
    {
      "type": "color",
      "id": "color_gold",
      "label": "Gold",
      "default": "#c8a05a"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "presets": [
    {
      "name": "DML Hero"
    }
  ]
}
{% endschema %}
