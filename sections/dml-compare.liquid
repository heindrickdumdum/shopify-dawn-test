{%- liquid
  assign uid = 'dml-compare-' | append: section.id
  assign s = section.settings
-%}

<div id="{{ uid }}" class="dml-compare">
  <div class="dml-compare__wrap">
    <div class="dml-compare__head">
      {%- if s.eyebrow != blank -%}<p class="dml-compare__eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      <h2 class="dml-compare__title">{{ s.heading }}</h2>
    </div>
    <div class="dml-compare__scroll">
      <table class="dml-compare__table">
        <thead>
          <tr>
            <th scope="col"><span class="dml-compare__sr">Benefit</span></th>
            <th scope="col">{{ s.col_1 }}</th>
            <th scope="col" class="is-featured">{{ s.col_2 }}</th>
            <th scope="col">{{ s.col_3 }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <th scope="row">{{ block.settings.row }}</th>
              <td>{{ block.settings.v1 }}</td>
              <td class="is-featured">{{ block.settings.v2 }}</td>
              <td>{{ block.settings.v3 }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
    {%- if s.cta_label != blank -%}
      <p class="dml-compare__cta"><a href="{{ s.cta_link }}">{{ s.cta_label }}</a></p>
    {%- endif -%}
  </div>
</div>

{%- style -%}
  #{{ uid }}, #{{ uid }} *, #{{ uid }} *::before, #{{ uid }} *::after { box-sizing: border-box; }
  #{{ uid }} :is(h2, p, table, thead, tbody, tr, th, td, a) { margin: 0; padding: 0; text-transform: none; letter-spacing: normal; border: 0; background: none; }
  #{{ uid }} {
    --c-primary: {{ s.color_primary }};
    --c-accent: {{ s.color_accent }};
    background: {{ s.color_bg }};
    padding: {{ s.padding_top }}px 20px {{ s.padding_bottom }}px;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 15px;
    line-height: 1.5;
    color: #5b5b66;
  }
  #{{ uid }} .dml-compare__wrap { max-width: 900px; margin: 0 auto; }
  #{{ uid }} .dml-compare__head { text-align: center; margin-bottom: 32px; }
  #{{ uid }} .dml-compare__eyebrow { font: 700 12px/1.4 'Montserrat', sans-serif; letter-spacing: .14em; text-transform: uppercase; color: var(--c-accent); margin-bottom: 10px; }
  #{{ uid }} .dml-compare__title { font: 800 clamp(24px, 3.8vw, 34px)/1.15 'Montserrat', sans-serif; color: var(--c-primary); }
  #{{ uid }} .dml-compare__scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; border: 1px solid #e7e3da; border-radius: 16px; background: #fff; }
  #{{ uid }} .dml-compare__table { width: 100%; min-width: 560px; border-collapse: collapse; text-align: center; }
  #{{ uid }} .dml-compare__table thead th { padding: 18px 12px; font: 700 14px/1.3 'Montserrat', sans-serif; color: var(--c-primary); border-bottom: 1px solid #e7e3da; }
  #{{ uid }} .dml-compare__table tbody th { text-align: left; padding: 14px 16px; font-weight: 600; color: #222; }
  #{{ uid }} .dml-compare__table td { padding: 14px 10px; font-size: 14px; }
  #{{ uid }} .dml-compare__table tbody th { width: 30%; min-width: 130px; }
  #{{ uid }} .dml-compare__table thead th { white-space: nowrap; }
  #{{ uid }} .dml-compare__table tbody tr + tr > * { border-top: 1px solid #f0ede6; }
  #{{ uid }} .dml-compare__table .is-featured { background: rgba(27, 37, 80, .05); color: var(--c-primary); font-weight: 700; }
  #{{ uid }} .dml-compare__sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  #{{ uid }} .dml-compare__cta { text-align: center; margin-top: 26px; }
  #{{ uid }} .dml-compare__cta a { display: inline-block; background: var(--c-accent); color: #fff; font: 700 15px/1.2 'Montserrat', sans-serif; padding: 15px 28px; border-radius: 999px; text-decoration: none; }

  @media (max-width: 860px) {
    #{{ uid }} { padding-top: {{ s.padding_top | times: 0.75 | round }}px; padding-bottom: {{ s.padding_bottom | times: 0.75 | round }}px; }
    #{{ uid }} .dml-compare__cta a { display: block; }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "DML Plan comparison",
  "class": "dml-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Compare" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why most customers choose a membership" },
    { "type": "text", "id": "col_1", "label": "Column 1", "default": "One-time" },
    { "type": "text", "id": "col_2", "label": "Column 2 (featured)", "default": "Quarterly" },
    { "type": "text", "id": "col_3", "label": "Column 3", "default": "Annual" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Choose your plan" },
    { "type": "text", "id": "cta_link", "label": "Button link", "default": "#pricing" },
    { "type": "color", "id": "color_primary", "label": "Primary", "default": "#1b2550" },
    { "type": "color", "id": "color_accent", "label": "Accent", "default": "#f86239" },
    { "type": "color", "id": "color_bg", "label": "Background", "default": "#ffffff" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        { "type": "text", "id": "row", "label": "Row label", "default": "Feature" },
        { "type": "text", "id": "v1", "label": "Column 1", "default": "—" },
        { "type": "text", "id": "v2", "label": "Column 2", "default": "✓" },
        { "type": "text", "id": "v3", "label": "Column 3", "default": "✓" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "DML Plan comparison",
      "blocks": [
        { "type": "row", "settings": { "row": "Price per box", "v1": "S$188", "v2": "S$97", "v3": "S$92" } },
        { "type": "row", "settings": { "row": "Free delivery", "v1": "—", "v2": "✓", "v3": "✓" } },
        { "type": "row", "settings": { "row": "Free membership upgrade", "v1": "—", "v2": "✓", "v3": "✓" } },
        { "type": "row", "settings": { "row": "Cancel or pause anytime", "v1": "n/a", "v2": "✓", "v3": "✓" } }
      ]
    }
  ]
}
{% endschema %}
