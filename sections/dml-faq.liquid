{%- liquid
  assign uid = 'dml-faq-' | append: section.id
  assign s = section.settings
-%}

<div id="{{ uid }}" class="dml-faq">
  <div class="dml-faq__wrap">
    <div class="dml-faq__head">
      {%- if s.eyebrow != blank -%}<p class="dml-faq__eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      <h2 class="dml-faq__title">{{ s.heading }}</h2>
    </div>
    <div class="dml-faq__list">
      {%- for block in section.blocks -%}
        <details class="dml-faq__item" {{ block.shopify_attributes }}>
          <summary class="dml-faq__q">{{ block.settings.question }}</summary>
          <div class="dml-faq__a">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</div>

{%- if section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | json }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{%- style -%}
  #{{ uid }}, #{{ uid }} *, #{{ uid }} *::before, #{{ uid }} *::after { box-sizing: border-box; }
  #{{ uid }} :is(h2, p, div, details, summary) { margin: 0; padding: 0; text-transform: none; letter-spacing: normal; }
  #{{ uid }} {
    --c-primary: {{ s.color_primary }};
    --c-accent: {{ s.color_accent }};
    background: {{ s.color_bg }};
    padding: {{ s.padding_top }}px 20px {{ s.padding_bottom }}px;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 16px;
    line-height: 1.6;
    color: #5b5b66;
  }
  #{{ uid }} .dml-faq__wrap { max-width: 760px; margin: 0 auto; }
  #{{ uid }} .dml-faq__head { text-align: center; margin-bottom: 36px; }
  #{{ uid }} .dml-faq__eyebrow { font: 700 12px/1.4 'Montserrat', sans-serif; letter-spacing: .14em; text-transform: uppercase; color: var(--c-accent); margin-bottom: 10px; }
  #{{ uid }} .dml-faq__title { font: 800 clamp(26px, 4vw, 38px)/1.15 'Montserrat', sans-serif; color: var(--c-primary); }
  #{{ uid }} .dml-faq__item { border-bottom: 1px solid #e7e3da; padding: 18px 0; }
  #{{ uid }} .dml-faq__q { cursor: pointer; list-style: none; display: flex; justify-content: space-between; gap: 16px; font: 600 16px/1.4 'Montserrat', sans-serif; color: var(--c-primary); }
  #{{ uid }} .dml-faq__q::-webkit-details-marker { display: none; }
  #{{ uid }} .dml-faq__q::after { content: "+"; font-size: 22px; line-height: 1; color: var(--c-accent); flex: none; }
  #{{ uid }} .dml-faq__item[open] .dml-faq__q::after { content: "–"; }
  #{{ uid }} .dml-faq__q:focus-visible { outline: 3px solid var(--c-accent); outline-offset: 4px; }
  #{{ uid }} .dml-faq__a { margin-top: 10px; font-size: 15px; }
  #{{ uid }} .dml-faq__a p { margin: 0; }

  @media (max-width: 860px) {
    #{{ uid }} { padding-top: {{ s.padding_top | times: 0.75 | round }}px; padding-bottom: {{ s.padding_bottom | times: 0.75 | round }}px; }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "DML FAQ",
  "class": "dml-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "FAQ" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions, answered" },
    { "type": "color", "id": "color_primary", "label": "Primary", "default": "#1b2550" },
    { "type": "color", "id": "color_accent", "label": "Accent", "default": "#f86239" },
    { "type": "color", "id": "color_bg", "label": "Background", "default": "#ffffff" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Answer</p>" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "DML FAQ",
      "blocks": [
        { "type": "question", "settings": { "question": "How do I take it?", "answer": "<p>Mix one sachet daily into water, smoothies, protein shakes or soups, preferably on an empty stomach in the morning.</p>" } },
        { "type": "question", "settings": { "question": "Is it safe during pregnancy or breastfeeding?", "answer": "<p>Please consult your healthcare professional before use.</p>" } },
        { "type": "question", "settings": { "question": "Can children take it?", "answer": "<p>Only with professional guidance.</p>" } }
      ]
    }
  ]
}
{% endschema %}
