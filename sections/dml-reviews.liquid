{%- liquid
  assign uid = 'dml-reviews-' | append: section.id
  assign s = section.settings
  assign stars_text = s.stars_label | replace: '{rating}', s.rating
  assign reviews_text = s.reviews_label | replace: '{count}', s.review_count
-%}

<div id="{{ s.anchor_id | default: 'reviews' }}" class="dml-reviews-anchor"></div>
<div id="{{ uid }}" class="dml-reviews">
  <div class="dml-reviews__wrap">
    <div class="dml-reviews__head">
      {%- if s.eyebrow != blank -%}<p class="dml-reviews__eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      <h2 class="dml-reviews__title">{{ s.heading }}</h2>
    </div>
    <p class="dml-reviews__rating">
      <strong>{{ s.rating }}</strong>
      <span class="dml-reviews__rating-meta">
        <span class="dml-reviews__stars" style="--rating: {{ s.rating }}" role="img" aria-label="{{ stars_text }}">★★★★★</span>
        <span>{{ reviews_text }}</span>
      </span>
    </p>
    <ul class="dml-reviews__grid">
      {%- for block in section.blocks -%}
        {%- assign block_stars_text = s.stars_label | replace: '{rating}', block.settings.stars -%}
        <li class="dml-reviews__card" {{ block.shopify_attributes }}>
          <span class="dml-reviews__stars" style="--rating: {{ block.settings.stars }}" role="img" aria-label="{{ block_stars_text }}">★★★★★</span>
          <blockquote class="dml-reviews__quote">“{{ block.settings.quote }}”</blockquote>
          <p class="dml-reviews__author">{{ block.settings.author }}</p>
        </li>
      {%- endfor -%}
    </ul>
    {%- if s.footnote != blank -%}<p class="dml-reviews__footnote">{{ s.footnote }}</p>{%- endif -%}
  </div>
</div>

{%- style -%}
  #{{ uid }}, #{{ uid }} *, #{{ uid }} *::before, #{{ uid }} *::after { box-sizing: border-box; }
  #{{ uid }} :is(h2, p, ul, li, blockquote, strong, span) { margin: 0; padding: 0; text-transform: none; letter-spacing: normal; }
  #{{ uid }} {
    --c-accent: {{ s.color_accent }};
    background: {{ s.color_bg }};
    color: {{ s.color_text }};
    padding: {{ s.padding_top }}px 20px {{ s.padding_bottom }}px;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 16px;
    line-height: 1.6;
  }
  #{{ uid }} .dml-reviews__wrap { max-width: 1120px; margin: 0 auto; }
  #{{ uid }} .dml-reviews__head { text-align: center; }
  #{{ uid }} .dml-reviews__eyebrow { font: 700 12px/1.4 'Montserrat', sans-serif; letter-spacing: .14em; text-transform: uppercase; color: {{ s.color_eyebrow }}; margin-bottom: 10px; }
  #{{ uid }} .dml-reviews__title { font: 800 clamp(26px, 4vw, 38px)/1.15 'Montserrat', sans-serif; color: inherit; }
  #{{ uid }} .dml-reviews__rating { display: flex; justify-content: center; align-items: center; gap: 14px; margin: 18px 0 40px; }
  #{{ uid }} .dml-reviews__rating strong { font: 800 48px/1 'Montserrat', sans-serif; }
  #{{ uid }} .dml-reviews__rating-meta { display: grid; font-size: 14px; opacity: .8; }
  #{{ uid }} .dml-reviews__stars { --p: calc(var(--rating) / 5 * 100%); display: inline-block; font-size: 18px; letter-spacing: 2px; line-height: 1.2; background: linear-gradient(90deg, {{ s.color_star }} var(--p), rgba(128, 128, 128, .45) var(--p)); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; color: transparent; }
  #{{ uid }} .dml-reviews__grid { list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 22px; }
  #{{ uid }} .dml-reviews__card { background: rgba(255, 255, 255, .07); border: 1px solid rgba(255, 255, 255, .14); border-radius: 16px; padding: 24px; }
  #{{ uid }} .dml-reviews__quote { margin: 10px 0 14px; font-size: 15px; }
  #{{ uid }} .dml-reviews__author { font-size: 13px; opacity: .7; }
  #{{ uid }} .dml-reviews__footnote { text-align: center; font-size: 12px; opacity: .7; margin-top: 22px; }

  @media (max-width: 860px) {
    #{{ uid }} { padding-top: {{ s.padding_top | times: 0.75 | round }}px; padding-bottom: {{ s.padding_bottom | times: 0.75 | round }}px; }
    #{{ uid }} .dml-reviews__grid { grid-template-columns: 1fr; }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "DML Reviews",
  "class": "dml-section",
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "default": "reviews"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Social proof"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Trusted by over 100,000 health-conscious users"
    },
    {
      "type": "range",
      "id": "rating",
      "label": "Average rating",
      "min": 1,
      "max": 5,
      "step": 0.1,
      "default": 4.5
    },
    {
      "type": "text",
      "id": "review_count",
      "label": "Review count",
      "default": "3,834"
    },
    {
      "type": "text",
      "id": "reviews_label",
      "label": "Review count text",
      "default": "{count} verified reviews",
      "info": "{count} is replaced with the review count."
    },
    {
      "type": "text",
      "id": "stars_label",
      "label": "Stars accessibility label",
      "default": "{rating} out of 5 stars"
    },
    {
      "type": "text",
      "id": "footnote",
      "label": "Footnote",
      "default": "Sample review text for demonstration. Replace with live reviews from your review app."
    },
    {
      "type": "color",
      "id": "color_bg",
      "label": "Background",
      "default": "#1b2550"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "color_accent",
      "label": "Accent",
      "default": "#c2410c"
    },
    {
      "type": "color",
      "id": "color_eyebrow",
      "label": "Eyebrow text",
      "default": "#c8a05a"
    },
    {
      "type": "color",
      "id": "color_star",
      "label": "Star colour",
      "default": "#f5a623"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "stars",
          "label": "Stars",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "Great product."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Customer"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "DML Reviews",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "quote": "My knees feel noticeably better on my morning runs. I take one sachet every day.",
            "author": "Sample review · Runner"
          }
        },
        {
          "type": "review",
          "settings": {
            "quote": "Less back ache after the gym and easier to get moving in the morning.",
            "author": "Sample review · Gym-goer"
          }
        },
        {
          "type": "review",
          "settings": {
            "quote": "Mixes into my coffee with no taste. The membership made it much more affordable.",
            "author": "Sample review · Member"
          }
        }
      ]
    }
  ]
}
{% endschema %}
