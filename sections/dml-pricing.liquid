{%- liquid
  assign uid = 'dml-pricing-' | append: section.id
  assign s = section.settings
  assign product = s.product
  assign variant = product.selected_or_first_available_variant
  assign anchor = s.anchor_id | default: 'pricing'
  assign form_id = uid | append: '-form'
  assign default_total = ''
  assign default_label = ''
  for block in section.blocks
    if block.settings.is_default or default_label == ''
      assign default_total = block.settings.total
      assign default_label = block.settings.name
    endif
  endfor
-%}

<div id="{{ anchor }}" class="dml-pricing-anchor"></div>
<div id="{{ uid }}" class="dml-pricing" data-dml-pricing data-cta-label="{{ s.cta_label | escape }}">
  <div class="dml-pricing__wrap">
    <div class="dml-pricing__head">
      {%- if s.eyebrow != blank -%}<p class="dml-pricing__eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      <h2 class="dml-pricing__title">{{ s.heading }}</h2>
      {%- if s.lead != blank -%}<p class="dml-pricing__lead">{{ s.lead }}</p>{%- endif -%}
    </div>

    {%- capture plans_html -%}
        <div class="dml-pricing__plans" role="radiogroup" aria-label="{{ s.heading | escape }}">
          {%- for block in section.blocks -%}
            {%- assign b = block.settings -%}
            <label class="dml-plan" {{ block.shopify_attributes }}>
              <input
                class="dml-plan__input"
                type="radio"
                name="selling_plan"
                value="{{ b.selling_plan_id }}"
                data-name="{{ b.name | escape }}"
                data-plan-id="{{ block.id }}"
                data-total="{{ b.total | escape }}"
                {% if b.is_default %}checked{% endif %}
              >
              <span class="dml-plan__card">
                {%- if b.tag != blank -%}<span class="dml-plan__tag dml-plan__tag--{{ b.tag_style }}">{{ b.tag }}</span>{%- endif -%}
                <span class="dml-plan__name">{{ b.name }}</span>
                <span class="dml-plan__price">{{ b.price }} <small>{{ b.unit }}</small></span>
                {%- if b.per_day != blank -%}<span class="dml-plan__perday">{{ b.per_day }}</span>{%- endif -%}
                {%- if b.savings != blank -%}<span class="dml-plan__save">{{ b.savings }}</span>{%- else -%}<span class="dml-plan__save dml-plan__save--empty"></span>{%- endif -%}
                {%- if b.perks != blank -%}
                  <span class="dml-plan__perks">
                    {%- assign perks = b.perks | newline_to_br | split: '<br />' -%}
                    {%- for perk in perks -%}{%- assign perk_clean = perk | strip_newlines | strip -%}{%- if perk_clean != blank -%}<span>{{ perk_clean }}</span>{%- endif -%}{%- endfor -%}
                  </span>
                {%- endif -%}
                <span class="dml-plan__radio" aria-hidden="true"></span>
              </span>
            </label>
          {%- endfor -%}
        </div>

        <div class="dml-pricing__cta">
          {%- if product == blank -%}
            <button type="button" class="dml-pricing__btn" disabled>{{ s.cta_label }}{% if default_total != blank %} · {{ default_total }}{% endif %}</button>
          {%- else -%}
            <button type="submit" class="dml-pricing__btn" data-dml-cta data-dml-track="add_to_cart" {% unless variant.available %}disabled{% endunless %}>
              {%- if variant.available -%}
                <span data-dml-cta-text>{{ s.cta_label }}{% if default_total != blank %} · {{ default_total }}{% endif %}</span>
              {%- else -%}
                {{ "products.product.sold_out" | t }}
              {%- endif -%}
            </button>
          {%- endif -%}
          {%- if s.cta_note != blank -%}<p class="dml-pricing__note">{{ s.cta_note }}</p>{%- endif -%}
          {%- if s.guarantee_items != blank -%}
            <ul class="dml-pricing__assure">
              {%- assign gi = s.guarantee_items | newline_to_br | split: '<br />' -%}
              {%- for g in gi -%}{%- assign g_clean = g | strip_newlines | strip -%}{%- if g_clean != blank -%}<li>{{ g_clean }}</li>{%- endif -%}{%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
    {%- endcapture -%}

    {%- if product != blank -%}
      {%- form "product", product, id: form_id, class: "dml-pricing__form", novalidate: "novalidate" -%}
        <input type="hidden" name="id" value="{{ variant.id }}">
        <input type="hidden" name="quantity" value="1">
        {%- if s.after_add == 'checkout' -%}<input type="hidden" name="return_to" value="/checkout">{%- endif -%}

        {{ plans_html }}
      {%- endform -%}
    {%- else -%}
      <div class="dml-pricing__form">{{ plans_html }}</div>
      <p class="dml-pricing__empty">Preview only: select a product in this section's settings to enable add to cart.</p>
    {%- endif -%}
  </div>

  {%- if s.show_sticky -%}
    <div class="dml-sticky" data-dml-sticky data-offset="{{ s.sticky_offset }}" role="region" aria-label="{{ s.cta_label | escape }}">
      <div class="dml-sticky__inner">
        {%- if product != blank -%}
          <label class="dml-sticky__plan">
            <span class="dml-sticky__sr">{{ s.heading }}</span>
            <select data-dml-sticky-select>
              {%- for block in section.blocks -%}
                <option value="{{ block.id }}" {% if block.settings.is_default %}selected{% endif %}>{{ block.settings.name }} · {{ block.settings.total }}</option>
              {%- endfor -%}
            </select>
          </label>
          <button type="submit" form="{{ form_id }}" class="dml-sticky__btn" data-dml-track="sticky_add_to_cart" {% unless variant.available %}disabled{% endunless %}>
            {%- if variant.available -%}{{ s.cta_label }} · <span data-dml-sticky-total>{{ default_total }}</span>{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
          </button>
        {%- else -%}
          <div class="dml-sticky__info"><span>{{ default_label }}</span><small>{{ default_total }}</small></div>
          <a class="dml-sticky__btn" href="#{{ anchor }}">{{ s.sticky_label }}</a>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
</div>

{%- style -%}
  #{{ uid }}, #{{ uid }} *, #{{ uid }} *::before, #{{ uid }} *::after { box-sizing: border-box; }
  #{{ uid }} :is(h2, p, div, span, small, label, button, a, form) { margin: 0; padding: 0; text-transform: none; letter-spacing: normal; }
  #{{ uid }} {
    --c-primary: {{ s.color_primary }};
    --c-accent: {{ s.color_accent }};
    --f-head: 'Montserrat', system-ui, sans-serif;
    background: {{ s.color_bg }};
    padding: {{ s.padding_top }}px 20px {{ s.padding_bottom }}px;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 16px;
    line-height: 1.6;
    color: #5b5b66;
  }
  #{{ uid }} .dml-pricing__wrap { max-width: 1120px; margin: 0 auto; }
  #{{ uid }} .dml-pricing__head { text-align: center; }
  #{{ uid }} .dml-pricing__eyebrow { font: 700 12px/1.4 var(--f-head); letter-spacing: .14em; text-transform: uppercase; color: var(--c-accent); margin-bottom: 10px; }
  #{{ uid }} .dml-pricing__title { font: 800 clamp(26px, 4vw, 38px)/1.15 var(--f-head); color: var(--c-primary); margin-bottom: 14px; }
  #{{ uid }} .dml-pricing__lead { max-width: 620px; margin: 0 auto; }
  #{{ uid }} .dml-pricing__plans { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; margin-top: 44px; align-items: stretch; }
  #{{ uid }} .dml-plan { display: block; position: relative; cursor: pointer; }
  #{{ uid }} .dml-plan__input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  #{{ uid }} .dml-plan__card { display: flex; flex-direction: column; height: 100%; position: relative; background: #fff; border: 2px solid #e7e3da; border-radius: 20px; padding: 30px 24px 24px; transition: border-color .15s, box-shadow .15s, transform .15s; }
  #{{ uid }} .dml-plan:hover .dml-plan__card { transform: translateY(-3px); }
  #{{ uid }} .dml-plan__input:checked + .dml-plan__card { border-color: var(--c-primary); box-shadow: 0 18px 40px rgba(27, 37, 80, .14); }
  #{{ uid }} .dml-plan__input:focus-visible + .dml-plan__card { outline: 3px solid var(--c-accent); outline-offset: 3px; }
  #{{ uid }} .dml-plan__tag { position: absolute; top: -13px; left: 24px; background: var(--c-primary); color: #fff; font: 700 11px/1 var(--f-head); letter-spacing: .08em; text-transform: uppercase; padding: 7px 12px; border-radius: 999px; }
  #{{ uid }} .dml-plan__tag--accent { background: var(--c-accent); }
  #{{ uid }} .dml-plan__name { font: 600 15px/1.4 var(--f-head); color: #5b5b66; margin-bottom: 10px; }
  #{{ uid }} .dml-plan__price { font: 800 34px/1.2 var(--f-head); color: var(--c-primary); }
  #{{ uid }} .dml-plan__price small { font: 500 14px/1 'Inter', sans-serif; color: #5b5b66; }
  #{{ uid }} .dml-plan__perday { display: inline-block; align-self: flex-start; margin-top: 6px; padding: 3px 9px; border-radius: 6px; background: #f1f3fb; color: var(--c-primary); font: 700 12px/1.4 var(--f-head); }
  #{{ uid }} .dml-plan__save--empty { display: block; }
  #{{ uid }} .dml-pricing__assure { list-style: none; display: flex; flex-wrap: wrap; justify-content: center; gap: 6px 18px; margin: 16px 0 0; padding: 0; font-size: 13px; }
  #{{ uid }} .dml-pricing__assure li { margin: 0; padding: 0; }
  #{{ uid }} .dml-pricing__assure li::before { content: "✓ "; color: var(--c-primary); font-weight: 700; }
  #{{ uid }} .dml-plan__save { min-height: 1.6em; color: var(--c-accent); font-weight: 700; font-size: 14px; margin: 6px 0 16px; }
  #{{ uid }} .dml-plan__perks { display: grid; gap: 6px; flex: 1; font-size: 14px; margin-bottom: 22px; }
  #{{ uid }} .dml-plan__perks span::before { content: "✓ "; color: var(--c-primary); font-weight: 700; }
  #{{ uid }} .dml-plan__radio { width: 20px; height: 20px; border-radius: 50%; border: 2px solid #cfcabd; background: #fff; align-self: flex-start; }
  #{{ uid }} .dml-plan__input:checked + .dml-plan__card .dml-plan__radio { border: 6px solid var(--c-primary); }
  #{{ uid }} .dml-pricing__cta { max-width: 420px; margin: 34px auto 0; text-align: center; }
  #{{ uid }} .dml-pricing__btn { display: block; width: 100%; background: var(--c-accent); color: #fff; font: 700 16px/1.2 var(--f-head); padding: 18px 32px; border: 0; border-radius: 999px; cursor: pointer; box-shadow: 0 8px 20px rgba(248, 98, 57, .28); transition: transform .15s, box-shadow .15s; }
  #{{ uid }} .dml-pricing__btn:hover { transform: translateY(-2px); box-shadow: 0 12px 24px rgba(248, 98, 57, .35); }
  #{{ uid }} .dml-pricing__btn:focus-visible { outline: 3px solid var(--c-primary); outline-offset: 3px; }
  #{{ uid }} .dml-pricing__btn[disabled] { opacity: .5; cursor: not-allowed; box-shadow: none; transform: none; }
  #{{ uid }} .dml-pricing__note { font-size: 13px; margin-top: 14px; }
  #{{ uid }} .dml-pricing__empty { text-align: center; margin-top: 30px; padding: 20px; border: 2px dashed #cfcabd; border-radius: 12px; }

  #{{ uid }} .dml-sticky { position: fixed; left: 0; right: 0; bottom: 0; z-index: 50; background: #fff; border-top: 1px solid #e7e3da; box-shadow: 0 -8px 24px rgba(0, 0, 0, .1); transform: translateY(110%); visibility: hidden; transition: transform .25s ease, visibility 0s linear .25s; }
  #{{ uid }} .dml-sticky.is-visible { transform: none; visibility: visible; transition: transform .25s ease; }
  #{{ uid }} .dml-sticky__inner { max-width: 1120px; margin: 0 auto; display: flex; align-items: center; justify-content: flex-end; gap: 12px; padding: 10px 16px calc(10px + env(safe-area-inset-bottom, 0px)); }
  #{{ uid }} .dml-sticky__plan { flex: 1 1 auto; max-width: 400px; min-width: 0; }
  #{{ uid }} .dml-sticky__sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  #{{ uid }} .dml-sticky select { display: block; width: 100%; margin: 0; padding: 12px 10px; border: 1px solid #d9d5c8; border-radius: 10px; background: #fff; color: var(--c-primary); font: 600 14px/1.2 var(--f-head); text-overflow: ellipsis; }
  #{{ uid }} .dml-sticky select:focus-visible { outline: 3px solid var(--c-accent); outline-offset: 2px; }
  #{{ uid }} .dml-sticky__info { flex: 1; font: 700 14px/1.3 var(--f-head); color: var(--c-primary); min-width: 0; }
  #{{ uid }} .dml-sticky__info small { display: block; font: 400 12px/1.3 'Inter', sans-serif; color: #5b5b66; }
  #{{ uid }} .dml-sticky__btn { flex: none; display: inline-block; background: var(--c-accent); color: #fff; font: 700 14px/1.2 var(--f-head); padding: 14px 24px; border: 0; border-radius: 999px; cursor: pointer; text-decoration: none; white-space: nowrap; box-shadow: 0 6px 16px rgba(248, 98, 57, .28); }
  #{{ uid }} .dml-sticky__btn:focus-visible { outline: 3px solid var(--c-primary); outline-offset: 2px; }
  #{{ uid }} .dml-sticky__btn[disabled] { opacity: .5; cursor: not-allowed; box-shadow: none; }

  @media (max-width: 860px) {
    #{{ uid }} { padding-top: {{ s.padding_top | times: 0.75 | round }}px; padding-bottom: {{ s.padding_bottom | times: 0.75 | round }}px; }
    #{{ uid }} .dml-pricing__plans { grid-template-columns: 1fr; }
    #{{ uid }} .dml-sticky__inner { padding-left: 12px; padding-right: 12px; gap: 8px; }
    #{{ uid }} .dml-sticky__btn { padding: 14px 16px; }
  }
{%- endstyle -%}

<script>
  (function () {
    var root = document.getElementById('{{ uid }}');
    if (!root || root.dataset.dmlReady) return;
    root.dataset.dmlReady = '1';
    var inputs = root.querySelectorAll('.dml-plan__input');
    var ctaText = root.querySelector('[data-dml-cta-text]');
    var sSelect = root.querySelector('[data-dml-sticky-select]');
    var sTotal = root.querySelector('[data-dml-sticky-total]');
    var label = root.getAttribute('data-cta-label');

    function update(input) {
      var total = input.getAttribute('data-total');
      if (ctaText) ctaText.textContent = label + (total ? ' · ' + total : '');
      if (sSelect) sSelect.value = input.getAttribute('data-plan-id');
      if (sTotal) sTotal.textContent = total;
    }
    function track(name, data) {
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push(Object.assign({ event: name }, data));
    }
    inputs.forEach(function (input) {
      input.addEventListener('change', function () {
        update(input);
        track('dml_select_plan', { plan: input.getAttribute('data-name'), total: input.getAttribute('data-total') });
      });
    });
    var form = root.querySelector('form');
    if (form) form.addEventListener('submit', function () {
      var c = root.querySelector('.dml-plan__input:checked');
      track('dml_add_to_cart', { plan: c && c.getAttribute('data-name'), total: c && c.getAttribute('data-total') });
    });

    if (sSelect) sSelect.addEventListener('change', function () {
      var match = root.querySelector('.dml-plan__input[data-plan-id="' + sSelect.value + '"]');
      if (match) { match.checked = true; match.dispatchEvent(new Event('change', { bubbles: true })); }
    });

    var sticky = root.querySelector('[data-dml-sticky]');
    var plans = root.querySelector('.dml-pricing__wrap');
    if (sticky) {
      var offset = parseInt(sticky.getAttribute('data-offset'), 10) || 600;
      var plansInView = false, ticking = false;
      var render = function () {
        ticking = false;
        sticky.classList.toggle('is-visible', window.pageYOffset > offset && !plansInView);
      };
      var onScroll = function () { if (!ticking) { ticking = true; requestAnimationFrame(render); } };
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      if (plans && 'IntersectionObserver' in window) {
        new IntersectionObserver(function (entries) {
          plansInView = entries[0].isIntersecting;
          onScroll();
        }, { threshold: 0.15 }).observe(plans);
      }
      render();
      var sBtn = sticky.querySelector('[data-dml-track]');
      if (sBtn) sBtn.addEventListener('click', function () { track('dml_sticky_cta_click', {}); });
    }
  })();
</script>

{% schema %}
{
  "name": "DML Pricing & plans",
  "class": "dml-section",
  "settings": [
    { "type": "product", "id": "product", "label": "Product", "info": "Required for add to cart. Plans below map to the product's selling plans." },
    { "type": "text", "id": "anchor_id", "label": "Anchor ID", "default": "pricing", "info": "Target for #pricing links." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Pricing" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Choose how you want to save" },
    { "type": "textarea", "id": "lead", "label": "Intro", "default": "Join the membership for the lowest price per box, free delivery and points towards gifts." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Add to cart" },
    { "type": "text", "id": "cta_note", "label": "Note under button", "default": "Secure checkout · Cancel or pause anytime" },
    {
      "type": "select", "id": "after_add", "label": "After adding to cart",
      "options": [{ "value": "cart", "label": "Go to cart" }, { "value": "checkout", "label": "Go to checkout" }],
      "default": "cart"
    },
    { "type": "textarea", "id": "guarantee_items", "label": "Assurance line (one per line)", "default": "Secure checkout\nCancel or pause anytime\nFree delivery on memberships" },
    { "type": "checkbox", "id": "show_sticky", "label": "Show floating add-to-cart bar", "default": true },
    { "type": "range", "id": "sticky_offset", "label": "Show after scrolling", "min": 200, "max": 1500, "step": 50, "unit": "px", "default": 600 },
    { "type": "text", "id": "sticky_label", "label": "Button label (when no product is set)", "default": "Choose plan" },
    { "type": "color", "id": "color_primary", "label": "Primary", "default": "#1b2550" },
    { "type": "color", "id": "color_accent", "label": "Button / accent", "default": "#f86239" },
    { "type": "color", "id": "color_bg", "label": "Background", "default": "#ffffff" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 }
  ],
  "blocks": [
    {
      "type": "plan",
      "name": "Plan",
      "settings": [
        { "type": "text", "id": "name", "label": "Plan name", "default": "One-time purchase" },
        { "type": "text", "id": "tag", "label": "Tag (optional)" },
        {
          "type": "select", "id": "tag_style", "label": "Tag style",
          "options": [{ "value": "primary", "label": "Primary" }, { "value": "accent", "label": "Accent" }],
          "default": "primary"
        },
        { "type": "text", "id": "price", "label": "Price per unit", "default": "S$188" },
        { "type": "text", "id": "unit", "label": "Unit", "default": "/ box" },
        { "type": "text", "id": "per_day", "label": "Cost per day (optional)" },
        { "type": "text", "id": "savings", "label": "Savings text" },
        { "type": "text", "id": "total", "label": "Total (shown on button)", "default": "S$188" },
        { "type": "textarea", "id": "perks", "label": "Perks (one per line)" },
        { "type": "text", "id": "selling_plan_id", "label": "Selling plan ID", "info": "Leave blank for a one-time purchase. Otherwise paste the numeric selling plan ID from the product." },
        { "type": "checkbox", "id": "is_default", "label": "Pre-selected", "default": false }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "DML Pricing & plans",
      "blocks": [
        { "type": "plan", "settings": { "name": "One-time purchase", "per_day": "≈ S$6.27 / day", "price": "S$188", "unit": "/ box", "total": "S$188", "perks": "1 box · 30 sachets\nStandard delivery" } },
        { "type": "plan", "settings": { "name": "Quarterly plan · 3 boxes", "tag": "Most popular", "price": "S$97", "unit": "/ box", "per_day": "≈ S$3.23 / day", "savings": "Save S$273 · S$291 total", "total": "S$291", "perks": "Free delivery\nFree membership upgrade\nCancel or pause anytime", "is_default": true } },
        { "type": "plan", "settings": { "name": "Annual plan · 12 boxes", "tag": "Best value", "tag_style": "accent", "price": "S$92", "unit": "/ box", "per_day": "≈ S$3.06 / day", "savings": "Save S$1,156 · S$1,100 total", "total": "S$1,100", "perks": "Free delivery\nFree membership upgrade\nPoints for gift redemption" } }
      ]
    }
  ]
}
{% endschema %}
