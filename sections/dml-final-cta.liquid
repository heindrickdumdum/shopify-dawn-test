{%- liquid
  assign uid = 'dml-final-' | append: section.id
  assign s = section.settings
  assign image_alt = s.image.alt | default: s.heading | strip_newlines
-%}

<div id="{{ uid }}" class="dml-final">
  <div class="dml-final__wrap">
    {%- if s.image != blank -%}
      {{ s.image | image_url: width: 400 | image_tag: widths: '200, 300, 400', sizes: '200px', loading: 'lazy', alt: image_alt }}
    {%- elsif s.use_bundled_image -%}
      <img src="{{ 'dml-collagen-sachets.png' | asset_url }}" alt="{{ s.heading | escape }}" width="200" height="200" loading="lazy">
    {%- endif -%}
    <h2 class="dml-final__title">{{ s.heading }}</h2>
    {%- if s.text != blank -%}<p class="dml-final__text">{{ s.text }}</p>{%- endif -%}
    <a class="dml-final__btn" href="{{ s.cta_link }}">{{ s.cta_label }}</a>
  </div>
  {%- if s.disclaimer != blank -%}
    <p class="dml-final__disclaimer">{{ s.disclaimer }}</p>
  {%- endif -%}
</div>

{%- style -%}
  #{{ uid }}, #{{ uid }} *, #{{ uid }} *::before, #{{ uid }} *::after { box-sizing: border-box; }
  #{{ uid }} :is(h2, p, a, div) { margin: 0; padding: 0; text-transform: none; letter-spacing: normal; }
  #{{ uid }} {
    --c-accent: {{ s.color_accent }};
    background: linear-gradient(135deg, {{ s.color_bg }}, {{ s.color_bg_2 }});
    color: #fff;
    padding: {{ s.padding_top }}px 20px {{ s.padding_bottom | plus: 72 }}px;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 16px;
    line-height: 1.6;
    text-align: center;
  }
  #{{ uid }} .dml-final__wrap { max-width: 640px; margin: 0 auto; }
  #{{ uid }} .dml-final__wrap img { display: block; width: 200px; height: auto; margin: 0 auto 20px; border-radius: 20px; }
  #{{ uid }} .dml-final__title { font: 800 clamp(26px, 4vw, 38px)/1.15 'Montserrat', sans-serif; color: #fff; margin-bottom: 14px; }
  #{{ uid }} .dml-final__text { color: {{ s.color_text }}; margin-bottom: 26px; }
  #{{ uid }} .dml-final__btn { display: inline-block; background: var(--c-accent); color: #fff; font: 700 19px/1.2 'Montserrat', sans-serif; padding: 16px 32px; border-radius: 999px; text-decoration: none; box-shadow: 0 8px 20px rgba(233, 96, 70, .35); }
  #{{ uid }} .dml-final__btn:focus-visible { outline: 3px solid #fff; outline-offset: 3px; }
  #{{ uid }} .dml-final__disclaimer { max-width: 760px; margin: 48px auto 0; font-size: 12px; color: {{ s.color_disclaimer }}; }

  @media (max-width: 860px) {
    #{{ uid }} { padding-top: {{ s.padding_top | times: 0.75 | round }}px; padding-bottom: {{ s.padding_bottom | times: 0.75 | round | plus: 72 }}px; }
    #{{ uid }} .dml-final__btn { display: block; }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "DML Final CTA",
  "class": "dml-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "checkbox",
      "id": "use_bundled_image",
      "label": "Use bundled sachet image if none uploaded",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Start your recovery today"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Join the membership and get the lowest price per box, free delivery and pause-anytime flexibility."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Start your membership today"
    },
    {
      "type": "text",
      "id": "cta_link",
      "label": "Button link",
      "default": "#pricing"
    },
    {
      "type": "textarea",
      "id": "disclaimer",
      "label": "Disclaimer",
      "default": "These statements have not been evaluated by a health authority. This product is not intended to diagnose, treat, cure or prevent any disease. Consult a healthcare professional before use."
    },
    {
      "type": "color",
      "id": "color_bg",
      "label": "Background from",
      "default": "#202f5a"
    },
    {
      "type": "color",
      "id": "color_bg_2",
      "label": "Background to",
      "default": "#2c3e73"
    },
    {
      "type": "color",
      "id": "color_accent",
      "label": "Button",
      "default": "#e96046"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Body text",
      "default": "#c5cae3"
    },
    {
      "type": "color",
      "id": "color_disclaimer",
      "label": "Disclaimer text",
      "default": "#9aa0c0"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "DML Final CTA"
    }
  ]
}
{% endschema %}
