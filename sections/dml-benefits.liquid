{%- liquid
  assign uid = 'dml-benefits-' | append: section.id
  assign s = section.settings
-%}

<div id="{{ uid }}" class="dml-benefits">
  <div class="dml-benefits__wrap">
    <div class="dml-benefits__head">
      {%- if s.eyebrow != blank -%}<p class="dml-benefits__eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      <h2 class="dml-benefits__title">{{ s.heading }}</h2>
      {%- if s.lead != blank -%}<p class="dml-benefits__lead">{{ s.lead }}</p>{%- endif -%}
    </div>
    <ul class="dml-benefits__grid">
      {%- for block in section.blocks -%}
        <li class="dml-benefits__card" {{ block.shopify_attributes }}>
          <span class="dml-benefits__icon" aria-hidden="true">{{ block.settings.icon }}</span>
          <h3 class="dml-benefits__card-title">{{ block.settings.title }}</h3>
          <p class="dml-benefits__card-text">{{ block.settings.text }}</p>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{%- style -%}
  #{{ uid }}, #{{ uid }} *, #{{ uid }} *::before, #{{ uid }} *::after { box-sizing: border-box; }
  #{{ uid }} :is(h2, h3, p, ul, li) { margin: 0; padding: 0; text-transform: none; letter-spacing: normal; }
  #{{ uid }} {
    --c-primary: {{ s.color_primary }};
    --c-accent: {{ s.color_accent }};
    background: {{ s.color_bg }};
    padding: {{ s.padding_top }}px 20px {{ s.padding_bottom }}px;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 16px;
    line-height: 1.6;
    color: {{ s.color_text }};
  }
  #{{ uid }} .dml-benefits__wrap { max-width: 1120px; margin: 0 auto; }
  #{{ uid }} .dml-benefits__head { text-align: center; }
  #{{ uid }} .dml-benefits__eyebrow { font: 700 12px/1.4 'Montserrat', sans-serif; letter-spacing: .14em; text-transform: uppercase; color: var(--c-accent); margin-bottom: 10px; }
  #{{ uid }} .dml-benefits__title { font: 800 clamp(26px, 4vw, 38px)/1.15 'Montserrat', sans-serif; color: var(--c-primary); margin-bottom: 14px; }
  #{{ uid }} .dml-benefits__lead { max-width: 620px; margin: 0 auto; }
  #{{ uid }} .dml-benefits__grid { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; margin-top: 40px; }
  #{{ uid }} .dml-benefits__card { background: #fff; border: 1px solid {{ s.color_border }}; border-radius: 16px; padding: 28px; }
  #{{ uid }} .dml-benefits__icon { display: grid; place-items: center; width: 46px; height: 46px; border-radius: 12px; background: #f6f4ef; font-size: 22px; margin-bottom: 16px; }
  #{{ uid }} .dml-benefits__card-title { font: 700 18px/1.3 'Montserrat', sans-serif; color: var(--c-primary); margin-bottom: 6px; }
  #{{ uid }} .dml-benefits__card-text { font-size: 15px; }

  @media (max-width: 860px) {
    #{{ uid }} { padding-top: {{ s.padding_top | times: 0.75 | round }}px; padding-bottom: {{ s.padding_bottom | times: 0.75 | round }}px; }
    #{{ uid }} .dml-benefits__grid { grid-template-columns: 1fr; }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "DML Benefits",
  "class": "dml-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Why it works"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Support for the way you move"
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Intro",
      "default": "Made for active adults, weekend athletes and anyone who wants to keep doing what they love."
    },
    {
      "type": "color",
      "id": "color_primary",
      "label": "Primary",
      "default": "#1b2550"
    },
    {
      "type": "color",
      "id": "color_accent",
      "label": "Accent",
      "default": "#f86239"
    },
    {
      "type": "color",
      "id": "color_bg",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Body text",
      "default": "#5b5b66"
    },
    {
      "type": "color",
      "id": "color_border",
      "label": "Borders",
      "default": "#e7e3da"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (emoji)",
          "default": "🦴"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Benefit title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Describe the benefit."
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "DML Benefits",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon": "🦴",
            "title": "Repair & support joints",
            "text": "Promotes joint health and supports cartilage, connective tissues and bones."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "💪",
            "title": "Faster muscle recovery",
            "text": "Supports muscle recovery and tissue repair after training and busy days."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "🏃",
            "title": "Flexibility & mobility",
            "text": "Helps protect cartilage from wear and tear for easier daily movement."
          }
        }
      ]
    }
  ]
}
{% endschema %}
