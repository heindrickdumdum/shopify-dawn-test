<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="preload" href="{{ 'dml-font-montserrat-latin.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="{{ 'dml-font-inter-latin.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- else -%}
      <link rel="icon" href="data:,">
    {%- endif -%}

    <title>
      {{- page_title -}}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- liquid
      assign meta_desc = page_description
      if meta_desc == blank
        assign meta_desc = page.content | strip_html | strip_newlines | truncate: 160
      endif
      if meta_desc == blank
        assign meta_desc = shop.description
      endif
      if meta_desc == blank
        assign meta_desc = page_title | append: ' - ' | append: shop.name
      endif
    -%}
    <meta name="description" content="{{ meta_desc | strip | escape_once }}">

    {% render 'meta-tags' %}

    {{ content_for_header }}

    <style>
      @font-face { font-family: 'Inter'; font-style: normal; font-weight: 400 500; font-display: swap; src: url({{ 'dml-font-inter-latin.woff2' | asset_url }}) format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }
      @font-face { font-family: 'Inter'; font-style: normal; font-weight: 400 500; font-display: swap; src: url({{ 'dml-font-inter-latin-ext.woff2' | asset_url }}) format('woff2'); unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF; }
      @font-face { font-family: 'Montserrat'; font-style: normal; font-weight: 600 800; font-display: swap; src: url({{ 'dml-font-montserrat-latin.woff2' | asset_url }}) format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }
      @font-face { font-family: 'Montserrat'; font-style: normal; font-weight: 600 800; font-display: swap; src: url({{ 'dml-font-montserrat-latin-ext.woff2' | asset_url }}) format('woff2'); unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF; }
      html { scroll-behavior: smooth; scroll-padding-top: 76px; }
      body { margin: 0; background: #fff; }
    </style>
  </head>

  <body>
    {%- comment -%}
      Landing layout: no store header, footer or announcement bar. The page template adds
      its own slim header and footer as sections (dml-header, dml-footer).
      Every landing section carries its own scoped CSS, so no theme stylesheet is loaded.
    {%- endcomment -%}
    <main id="MainContent" role="main">
      {{ content_for_layout }}
    </main>
  </body>
</html>
