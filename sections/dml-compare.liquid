{%- liquid
  assign uid = 'dml-compare-' | append: section.id
  assign s = section.settings
  assign product = s.product
  assign variant = product.selected_or_first_available_variant
  assign days = s.days_per_box | default: 30
  assign dash = '—'

  assign one_cents = 0
  assign c2_cents = 0
  assign c3_cents = 0
  if product != blank
    assign one_cents = variant.price
    assign c2_index = s.col_2_plan | minus: 1
    assign c3_index = s.col_3_plan | minus: 1
    assign alloc_2 = variant.selling_plan_allocations[c2_index]
    assign alloc_3 = variant.selling_plan_allocations[c3_index]
    if alloc_2 != blank
      assign c2_cents = alloc_2.per_delivery_price
    endif
    if alloc_3 != blank
      assign c3_cents = alloc_3.per_delivery_price
    endif
  endif

  assign price_1 = dash
  assign price_2 = dash
  assign price_3 = dash
  assign save_2 = dash
  assign save_3 = dash
  assign day_1 = dash
  assign day_2 = dash
  assign day_3 = dash

  if one_cents > 0
    assign price_1 = one_cents | money
    assign day_1 = one_cents | divided_by: days | round | money
  endif
  if c2_cents > 0
    assign price_2 = c2_cents | money
    assign day_2 = c2_cents | divided_by: days | round | money
    if one_cents > c2_cents
      assign diff_2 = one_cents | minus: c2_cents
      assign pct_2 = diff_2 | times: 100.0 | divided_by: one_cents | round
      assign save_2 = s.save_label | replace: '{percent}', pct_2
    endif
  endif
  if c3_cents > 0
    assign price_3 = c3_cents | money
    assign day_3 = c3_cents | divided_by: days | round | money
    if one_cents > c3_cents
      assign diff_3 = one_cents | minus: c3_cents
      assign pct_3 = diff_3 | times: 100.0 | divided_by: one_cents | round
      assign save_3 = s.save_label | replace: '{percent}', pct_3
    endif
  endif
-%}

<div id="{{ uid }}" class="dml-compare">
  <div class="dml-compare__wrap">
    <div class="dml-compare__head">
      {%- if s.eyebrow != blank -%}<p class="dml-compare__eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      <h2 class="dml-compare__title">{{ s.heading }}</h2>
    </div>
    <div class="dml-compare__scroll">
      <table class="dml-compare__table">
        <thead>
          <tr>
            <th scope="col"><span class="dml-compare__sr">Benefit</span></th>
            <th scope="col">{{ s.col_1 }}</th>
            <th scope="col" class="is-featured">{{ s.col_2 }}</th>
            <th scope="col">{{ s.col_3 }}</th>
          </tr>
        </thead>
        <tbody>
          {%- if s.show_price_row -%}
            <tr>
              <th scope="row">{{ s.price_row_label }}</th>
              <td>{{ price_1 }}</td>
              <td class="is-featured">{{ price_2 }}</td>
              <td>{{ price_3 }}</td>
            </tr>
          {%- endif -%}
          {%- if s.show_save_row -%}
            <tr>
              <th scope="row">{{ s.save_row_label }}</th>
              <td>{{ dash }}</td>
              <td class="is-featured">{{ save_2 }}</td>
              <td>{{ save_3 }}</td>
            </tr>
          {%- endif -%}
          {%- if s.show_per_day_row -%}
            <tr>
              <th scope="row">{{ s.per_day_row_label }}</th>
              <td>{{ day_1 }}</td>
              <td class="is-featured">{{ day_2 }}</td>
              <td>{{ day_3 }}</td>
            </tr>
          {%- endif -%}
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <th scope="row">{{ block.settings.row }}</th>
              <td>{{ block.settings.v1 }}</td>
              <td class="is-featured">{{ block.settings.v2 }}</td>
              <td>{{ block.settings.v3 }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
    {%- if product == blank -%}
      <p class="dml-compare__empty">Select a product in this section's settings to show live prices.</p>
    {%- endif -%}
    {%- if s.cta_label != blank -%}
      <p class="dml-compare__cta"><a href="{{ s.cta_link }}">{{ s.cta_label }}</a></p>
    {%- endif -%}
  </div>
</div>

{%- style -%}
  #{{ uid }}, #{{ uid }} *, #{{ uid }} *::before, #{{ uid }} *::after { box-sizing: border-box; }
  #{{ uid }} :is(h2, p, table, thead, tbody, tr, th, td, a) { margin: 0; padding: 0; text-transform: none; letter-spacing: normal; border: 0; background: none; }
  #{{ uid }} {
    --c-primary: {{ s.color_primary }};
    --c-accent: {{ s.color_accent }};
    background: {{ s.color_bg }};
    padding: {{ s.padding_top }}px 20px {{ s.padding_bottom }}px;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 15px;
    line-height: 1.5;
    color: #5b5b66;
  }
  #{{ uid }} .dml-compare__wrap { max-width: 900px; margin: 0 auto; }
  #{{ uid }} .dml-compare__head { text-align: center; margin-bottom: 32px; }
  #{{ uid }} .dml-compare__eyebrow { font: 700 12px/1.4 'Montserrat', sans-serif; letter-spacing: .14em; text-transform: uppercase; color: var(--c-accent); margin-bottom: 10px; }
  #{{ uid }} .dml-compare__title { font: 800 clamp(24px, 3.8vw, 34px)/1.15 'Montserrat', sans-serif; color: var(--c-primary); }
  #{{ uid }} .dml-compare__scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; border: 1px solid #e7e3da; border-radius: 16px; background: #fff; }
  #{{ uid }} .dml-compare__table { width: 100%; min-width: 560px; border-collapse: collapse; text-align: center; }
  #{{ uid }} .dml-compare__table thead th { padding: 18px 12px; font: 700 14px/1.3 'Montserrat', sans-serif; color: var(--c-primary); border-bottom: 1px solid #e7e3da; white-space: nowrap; }
  #{{ uid }} .dml-compare__table tbody th { text-align: left; padding: 14px 16px; font-weight: 600; color: #222; width: 30%; min-width: 130px; }
  #{{ uid }} .dml-compare__table td { padding: 14px 10px; font-size: 14px; }
  #{{ uid }} .dml-compare__table tbody tr + tr > * { border-top: 1px solid #f0ede6; }
  #{{ uid }} .dml-compare__table .is-featured { background: rgba(27, 37, 80, .05); color: var(--c-primary); font-weight: 700; }
  #{{ uid }} .dml-compare__sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  #{{ uid }} .dml-compare__empty { text-align: center; font-size: 13px; margin-top: 14px; }
  #{{ uid }} .dml-compare__cta { text-align: center; margin-top: 26px; }
  #{{ uid }} .dml-compare__cta a { display: inline-block; background: var(--c-accent); color: #fff; font: 700 15px/1.2 'Montserrat', sans-serif; padding: 15px 28px; border-radius: 999px; text-decoration: none; }

  @media (max-width: 860px) {
    #{{ uid }} { padding-top: {{ s.padding_top | times: 0.75 | round }}px; padding-bottom: {{ s.padding_bottom | times: 0.75 | round }}px; }
    #{{ uid }} .dml-compare__cta a { display: block; }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "DML Plan comparison",
  "class": "dml-section",
  "settings": [
    { "type": "product", "id": "product", "label": "Product", "info": "Prices are read from the product and its subscription plans, in the store's currency." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Compare" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why most customers choose a membership" },
    { "type": "header", "content": "Columns" },
    { "type": "text", "id": "col_1", "label": "Column 1 (one-time purchase)", "default": "One-time" },
    { "type": "text", "id": "col_2", "label": "Column 2 (featured)", "default": "Quarterly" },
    {
      "type": "select", "id": "col_2_plan", "label": "Column 2 subscription plan",
      "options": [{ "value": "1", "label": "Plan 1" }, { "value": "2", "label": "Plan 2" }, { "value": "3", "label": "Plan 3" }, { "value": "4", "label": "Plan 4" }],
      "default": "1"
    },
    { "type": "text", "id": "col_3", "label": "Column 3", "default": "Annual" },
    {
      "type": "select", "id": "col_3_plan", "label": "Column 3 subscription plan",
      "options": [{ "value": "1", "label": "Plan 1" }, { "value": "2", "label": "Plan 2" }, { "value": "3", "label": "Plan 3" }, { "value": "4", "label": "Plan 4" }],
      "default": "2"
    },
    { "type": "header", "content": "Live rows" },
    { "type": "checkbox", "id": "show_price_row", "label": "Show price per box", "default": true },
    { "type": "text", "id": "price_row_label", "label": "Price row label", "default": "Price per box" },
    { "type": "checkbox", "id": "show_save_row", "label": "Show savings", "default": true },
    { "type": "text", "id": "save_row_label", "label": "Savings row label", "default": "You save" },
    { "type": "text", "id": "save_label", "label": "Savings text", "default": "{percent}% off", "info": "{percent} is replaced with the discount versus the one-time price." },
    { "type": "checkbox", "id": "show_per_day_row", "label": "Show cost per day", "default": true },
    { "type": "text", "id": "per_day_row_label", "label": "Cost-per-day row label", "default": "Cost per day" },
    { "type": "range", "id": "days_per_box", "label": "Days one box lasts", "min": 1, "max": 90, "step": 1, "default": 30 },
    { "type": "header", "content": "Button and style" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Choose your plan" },
    { "type": "text", "id": "cta_link", "label": "Button link", "default": "#pricing" },
    { "type": "color", "id": "color_primary", "label": "Primary", "default": "#1b2550" },
    { "type": "color", "id": "color_accent", "label": "Accent", "default": "#f86239" },
    { "type": "color", "id": "color_bg", "label": "Background", "default": "#ffffff" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Text row",
      "settings": [
        { "type": "text", "id": "row", "label": "Row label", "default": "Feature" },
        { "type": "text", "id": "v1", "label": "Column 1", "default": "—" },
        { "type": "text", "id": "v2", "label": "Column 2", "default": "✓" },
        { "type": "text", "id": "v3", "label": "Column 3", "default": "✓" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "DML Plan comparison",
      "blocks": [
        { "type": "row", "settings": { "row": "Free delivery", "v1": "—", "v2": "✓", "v3": "✓" } },
        { "type": "row", "settings": { "row": "Free membership upgrade", "v1": "—", "v2": "✓", "v3": "✓" } },
        { "type": "row", "settings": { "row": "Cancel or pause anytime", "v1": "n/a", "v2": "✓", "v3": "✓" } }
      ]
    }
  ]
}
{% endschema %}
