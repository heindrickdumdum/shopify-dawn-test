{%- liquid
  assign uid = 'dml-footer-' | append: section.id
  assign s = section.settings
  assign home_url = s.logo_url | default: routes.root_url
  assign logo_alt = s.logo.alt | default: shop.name
  assign this_year = 'now' | date: '%Y'
  assign copyright_text = s.copyright | replace: '{year}', this_year
-%}

<footer id="{{ uid }}" class="dml-footer">
  <div class="dml-footer__inner">
    <div class="dml-footer__brand">
      <a class="dml-footer__logo" href="{{ home_url }}">
        {%- if s.logo != blank -%}
          {{ s.logo | image_url: width: 600 | image_tag: widths: '150, 300, 450, 600', sizes: '200px', loading: 'lazy', alt: logo_alt }}
        {%- else -%}
          <img src="{{ 'dml-logo-white.png' | asset_url }}" alt="{{ logo_alt | escape }}" width="600" height="184" loading="lazy">
        {%- endif -%}
      </a>
      {%- if s.tagline != blank -%}<p class="dml-footer__tagline">{{ s.tagline }}</p>{%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <nav class="dml-footer__nav" aria-label="{{ s.nav_label | escape }}">
        <ul class="dml-footer__links">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}><a href="{{ block.settings.url | default: '#' }}">{{ block.settings.label }}</a></li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}
  </div>

  <div class="dml-footer__bottom">
    {%- if copyright_text != blank -%}<p class="dml-footer__copy">{{ copyright_text }}</p>{%- endif -%}
    {%- if s.disclaimer != blank -%}<p class="dml-footer__disclaimer">{{ s.disclaimer }}</p>{%- endif -%}
  </div>
</footer>

{%- style -%}
  #{{ uid }}, #{{ uid }} *, #{{ uid }} *::before, #{{ uid }} *::after { box-sizing: border-box; }
  #{{ uid }} :is(p, ul, li, a, nav, img) { margin: 0; padding: 0; text-transform: none; letter-spacing: normal; }
  #{{ uid }} {
    background: {{ s.color_bg }};
    color: {{ s.color_text }};
    padding: {{ s.padding_top }}px 20px {{ s.padding_bottom | plus: 72 }}px;
    font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
    font-size: 14px;
    line-height: 1.6;
  }
  #{{ uid }} .dml-footer__inner { max-width: 1120px; margin: 0 auto; display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; gap: 28px 48px; }
  #{{ uid }} .dml-footer__brand { max-width: 340px; }
  #{{ uid }} .dml-footer__logo { display: inline-block; line-height: 0; }
  #{{ uid }} .dml-footer__logo img { display: block; width: {{ s.logo_width }}px; max-width: 100%; height: auto; }
  #{{ uid }} .dml-footer__tagline { margin-top: 14px; color: {{ s.color_text }}; }
  #{{ uid }} .dml-footer__links { list-style: none; display: flex; flex-wrap: wrap; gap: 10px 28px; }
  #{{ uid }} .dml-footer__links li { margin: 0; padding: 0; }
  #{{ uid }} .dml-footer__links a { color: {{ s.color_link }}; text-decoration: none; font-weight: 500; }
  #{{ uid }} .dml-footer__links a:hover { text-decoration: underline; text-underline-offset: 3px; }
  #{{ uid }} .dml-footer__links a:focus-visible { outline: 3px solid {{ s.color_link }}; outline-offset: 3px; }
  #{{ uid }} .dml-footer__bottom { max-width: 1120px; margin: 28px auto 0; padding-top: 22px; border-top: 1px solid {{ s.color_border }}; display: grid; gap: 10px; }
  #{{ uid }} .dml-footer__copy { color: {{ s.color_text }}; }
  #{{ uid }} .dml-footer__disclaimer { font-size: 12px; color: {{ s.color_muted }}; max-width: 820px; }

  @media (max-width: 860px) {
    #{{ uid }} .dml-footer__inner { flex-direction: column; }
    #{{ uid }} .dml-footer__links { flex-direction: column; gap: 12px; }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "DML Footer",
  "class": "dml-section",
  "settings": [
    { "type": "header", "content": "Brand" },
    { "type": "image_picker", "id": "logo", "label": "Logo", "info": "Use a light or white logo on a dark background. Falls back to the bundled white logo." },
    { "type": "range", "id": "logo_width", "label": "Logo width", "min": 80, "max": 280, "step": 5, "unit": "px", "default": 160 },
    { "type": "url", "id": "logo_url", "label": "Logo link", "info": "Leave blank to link to the store home page." },
    { "type": "textarea", "id": "tagline", "label": "Tagline", "default": "Science-backed wellness from Dr. Mark Leong." },
    { "type": "header", "content": "Links" },
    { "type": "text", "id": "nav_label", "label": "Navigation label (screen readers)", "default": "Footer" },
    { "type": "header", "content": "Legal text" },
    { "type": "text", "id": "copyright", "label": "Copyright", "default": "© {year} Dr. Mark Leong. All rights reserved.", "info": "{year} is replaced with the current year." },
    { "type": "textarea", "id": "disclaimer", "label": "Disclaimer", "default": "These statements have not been evaluated by a health authority. This product is not intended to diagnose, treat, cure or prevent any disease. Consult a healthcare professional before use." },
    { "type": "header", "content": "Style" },
    { "type": "color", "id": "color_bg", "label": "Background", "default": "#182348" },
    { "type": "color", "id": "color_text", "label": "Text", "default": "#d6dbf0" },
    { "type": "color", "id": "color_link", "label": "Links", "default": "#ffffff" },
    { "type": "color", "id": "color_muted", "label": "Disclaimer text", "default": "#aab1d6" },
    { "type": "color", "id": "color_border", "label": "Divider", "default": "#33406e" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24, "info": "72px is added automatically so the floating add-to-cart bar never covers the footer." }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Link" },
        { "type": "url", "id": "url", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "DML Footer",
      "blocks": [
        { "type": "link", "settings": { "label": "Privacy Policy" } },
        { "type": "link", "settings": { "label": "Terms of Service" } },
        { "type": "link", "settings": { "label": "Shipping Policy" } },
        { "type": "link", "settings": { "label": "Refund Policy" } },
        { "type": "link", "settings": { "label": "Contact" } }
      ]
    }
  ]
}
{% endschema %}
